<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Static</NativeLib>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <LibnxLoopGcPolls>true</LibnxLoopGcPolls>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup><DirectPInvoke Include="__Internal" /></ItemGroup>
  <Import Project="$(LibnxRuntimeRoot)/ports/libnx/Libnx.NativeAOT.targets" />
  <Import Project="$(LibnxRuntimeRoot)/ports/libnx/Libnx.PartialNativeLibraries.targets" />
</Project>
