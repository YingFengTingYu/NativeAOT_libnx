ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.400
FROM ${DOTNET_SDK_IMAGE} AS dotnet_sdk
FROM nativeaot-libnx-build:10.0.11
COPY --from=dotnet_sdk /usr/share/dotnet/ /opt/dotnet/
ENV DOTNET_ROOT=/opt/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PATH=/opt/dotnet:/opt/devkitpro/devkitA64/bin:/opt/devkitpro/tools/bin:$PATH
WORKDIR /runtime
