<Project>
  <!-- The stock Linux ARM64 ILC can emit TPIDR_EL0 accesses for managed
       thread statics. Use runtime helpers until libnx-specific inline codegen
       is implemented. This does not disable thread statics themselves. -->
  <ItemGroup>
    <IlcArg Include="--noinlinetls" />
    <IlcArg Include="--jitpath:$(LibnxJitPath)" Condition="'$(LibnxJitPath)' != ''" />
    <IlcArg Include="--codegenopt:LibnxLoopGcPolls=1" Condition="'$(LibnxLoopGcPolls)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateLibnxLoopGcPolls" BeforeTargets="IlcCompile">
    <Error Condition="'$(LibnxLoopGcPolls)' == 'true' and '$(LibnxJitPath)' == ''"
           Text="LibnxLoopGcPolls requires LibnxJitPath to the patched ARM64 code generator." />
  </Target>
</Project>
